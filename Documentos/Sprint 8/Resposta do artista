  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
  /* ============================================================
     PROTÓTIPO · tudo roda no navegador (localStorage), sem servidor.
     Contas de teste (senha de todas: 123456):
       selvaritmo     artista  -> responde às avaliações de "Selva Ritmo"
       saborquintal   artista  -> responde às avaliações de "Sabor de Quintal"
       magotheo       artista  -> responde às avaliações de "Mago Theo"
       cliente        cliente  -> vê tudo, sem botões de resposta
     No site real, login, cadastro e respostas vêm do banco de dados.
     ============================================================ */
  (function () {
    var MAX = 500;
    var K_USERS = 'artconnect_users_v1', K_REPLIES = 'artconnect_respostas_v1', K_SESSION = 'artconnect_session_v1';
    var mem = {};

    /* ---------- armazenamento (com reserva em memória) ---------- */
    function lget(k) { try { var v = localStorage.getItem(k); return v === null ? null : JSON.parse(v); } catch (e) { return k in mem ? JSON.parse(mem[k]) : null; } }
    function lset(k, v) { var s = JSON.stringify(v); mem[k] = s; try { localStorage.setItem(k, s); } catch (e) {} }
    function getSession() {
      try { var s = sessionStorage.getItem(K_SESSION); if (s) return JSON.parse(s); } catch (e) {}
      return lget(K_SESSION) || (mem.sess ? JSON.parse(mem.sess) : null);
    }
    function setSession(u, remember) {
      var data = u ? { usuario: u.usuario, nome: u.nome, tipo: u.tipo, artistId: u.artistId } : null;
      try { sessionStorage.removeItem(K_SESSION); } catch (e) {}
      try { localStorage.removeItem(K_SESSION); } catch (e) {}
      delete mem[K_SESSION]; delete mem.sess;
      if (!data) return;
      mem.sess = JSON.stringify(data);
      try { (remember ? localStorage : sessionStorage).setItem(K_SESSION, JSON.stringify(data)); } catch (e) {}
    }

    /* ---------- utilidades ---------- */
    function $(s, r) { return (r || document).querySelector(s); }
    function $$(s, r) { return Array.prototype.slice.call((r || document).querySelectorAll(s)); }
    function esc(s) { var d = document.createElement('div'); d.textContent = s; return d.innerHTML; }
    function slug(s) { return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, ''); }
    function fmt(iso) { try { return new Date(iso).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' }); } catch (e) { return ''; } }
    var toastT;
    function toast(msg) { var t = $('#toast'); t.textContent = msg; t.classList.add('is-on'); clearTimeout(toastT); toastT = setTimeout(function () { t.classList.remove('is-on'); }, 3200); }

    function sha(user, pass) {
      var s = 'artconnect:' + user + ':' + pass;
      if (window.crypto && crypto.subtle && window.TextEncoder) {
        return crypto.subtle.digest('SHA-256', new TextEncoder().encode(s)).then(function (b) {
          return Array.prototype.map.call(new Uint8Array(b), function (x) { return ('0' + x.toString(16)).slice(-2); }).join('');
        });
      }
      return Promise.resolve('b64:' + btoa(unescape(encodeURIComponent(s))));
    }

    var SEED_USERS = [
      { usuario: 'selvaritmo', nome: 'Selva Ritmo', email: 'selva@exemplo.com', tipo: 'artista', categoria: 'DJs', cidade: 'São Paulo', artistId: 'selva-ritmo' },
      { usuario: 'saborquintal', nome: 'Sabor de Quintal', email: 'sabor@exemplo.com', tipo: 'artista', categoria: 'Chefs & Buffet', cidade: 'São Paulo', artistId: 'sabor-de-quintal' },
      { usuario: 'magotheo', nome: 'Mago Theo', email: 'theo@exemplo.com', tipo: 'artista', categoria: 'Mágicos', cidade: 'São Paulo', artistId: 'mago-theo' },
      { usuario: 'cliente', nome: 'Cliente Teste', email: 'cliente@exemplo.com', tipo: 'cliente', artistId: null }
    ];
    function loadUsers() {
      var u = lget(K_USERS);
      if (u) return Promise.resolve(u);
      u = {};
      return Promise.all(SEED_USERS.map(function (s) {
        return sha(s.usuario, '123456').then(function (h) { var o = JSON.parse(JSON.stringify(s)); o.hash = h; u[s.usuario] = o; });
      })).then(function () { lset(K_USERS, u); return u; });
    }

    /* ---------- respostas do artista ---------- */
    var seedReplies = {
      r1: { body: 'Valeu, Marcos! A pista da formatura estava incrível e a equipe de som ajudou demais. Foi um prazer fazer parte da noite. Quando precisar, é só chamar.', artistId: 'selva-ritmo', artistName: 'Selva Ritmo', at: '2026-10-12T14:20:00-03:00', edited: false },
      r3: { body: 'Obrigado, Tainá! Foi muito especial entrar na festa dos 40. Fico feliz que a surpresa tenha rendido conversa a noite toda.', artistId: 'mago-theo', artistName: 'Mago Theo', at: '2026-10-20T09:05:00-03:00', edited: false }
    };
    var replies = lget(K_REPLIES) || JSON.parse(JSON.stringify(seedReplies));
    function saveReplies() { lset(K_REPLIES, replies); }

    function renderReview(card) {
      var id = card.dataset.reviewId, r = replies[id], s = getSession();
      var isOwner = !!(s && s.tipo === 'artista' && s.artistId && s.artistId === card.dataset.artistId);
      var h = '';
      if (r) {
        h += '<div class="reply" role="group" aria-label="Resposta do artista">' +
          '<div class="reply__head"><span class="reply__badge">Resposta do artista</span><span class="reply__name">' + esc(r.artistName) + '</span></div>' +
          '<p class="reply__text">' + esc(r.body) + '</p>' +
          '<p class="reply__meta">' + fmt(r.at) + (r.edited ? ' · editada' : '') + '</p></div>';
      }
      if (isOwner) {
        h += '<div class="rp-actions">' + (r
          ? '<button type="button" class="rp-btn" data-act="open">Editar resposta</button><button type="button" class="rp-btn rp-btn--danger" data-act="del">Excluir</button>'
          : '<button type="button" class="rp-btn rp-btn--primary" data-act="open">Responder</button>') + '</div>' +
          '<form class="rp-form" hidden novalidate>' +
          '<label class="rp-label" for="rp-' + id + '">Sua resposta pública</label>' +
          '<textarea class="rp-textarea" id="rp-' + id + '" maxlength="' + MAX + '" placeholder="Agradeça, esclareça algo ou conte como foi o evento. Todos vão ler."></textarea>' +
          '<p class="rp-error" role="alert"></p>' +
          '<div class="rp-foot"><span class="rp-count" aria-live="polite">0/' + MAX + '</span><span class="rp-btns">' +
          '<button type="button" class="rp-btn" data-act="cancel">Cancelar</button>' +
          '<button type="submit" class="rp-btn rp-btn--primary">Publicar resposta</button></span></div></form>' +
          '<p class="rp-status" role="status" aria-live="polite"></p>';
      }
      $('.reply-slot', card).innerHTML = h;
    }
    function renderReviews() {
      $$('.review').forEach(renderReview);
      var s = getSession(), n = $('#as-artist');
      if (s && s.tipo === 'artista') {
        n.hidden = false;
        n.innerHTML = 'Você entrou como <strong>' + esc(s.nome) + '</strong>. Responda às avaliações que recebeu: o botão aparece só nelas.';
      } else { n.hidden = true; }
    }
    function updCount(ta) {
      var c = $('.rp-count', ta.closest('form'));
      c.textContent = ta.value.length + '/' + MAX; c.classList.toggle('is-near', ta.value.length >= MAX - 40);
    }

    document.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-act]');
      if (!btn) return;
      var card = btn.closest('.review'), id = card.dataset.reviewId;
      var form = $('.rp-form', card), actions = $('.rp-actions', card), ta = form && $('textarea', form), act = btn.dataset.act;
      if (act === 'open') {
        ta.value = replies[id] ? replies[id].body : ''; updCount(ta);
        form.hidden = false; actions.hidden = true; ta.focus();
      } else if (act === 'cancel') {
        form.hidden = true; actions.hidden = false; $('[data-act="open"]', actions).focus();
      } else if (act === 'del') {
        if (btn.dataset.confirm !== '1') {
          btn.dataset.confirm = '1'; btn.textContent = 'Confirmar exclusão';
          setTimeout(function () { if (btn.isConnected) { btn.dataset.confirm = ''; btn.textContent = 'Excluir'; } }, 4000);
          return;
        }
        delete replies[id]; saveReplies(); renderReview(card);
        $('.rp-status', card).textContent = 'Resposta excluída.'; $('[data-act="open"]', card).focus();
      }
    });
    document.addEventListener('input', function (e) { if (e.target.classList.contains('rp-textarea')) updCount(e.target); });
    document.addEventListener('submit', function (e) {
      var form = e.target.closest('.rp-form');
      if (!form) return;
      e.preventDefault();
      var card = form.closest('.review'), id = card.dataset.reviewId, s = getSession();
      var ta = $('textarea', form), err = $('.rp-error', form), body = ta.value.trim();
      if (!s || s.tipo !== 'artista' || s.artistId !== card.dataset.artistId) { err.textContent = 'Só o artista desta avaliação pode responder.'; return; }
      if (body.length < 5) { err.textContent = 'Escreva ao menos 5 caracteres.'; ta.focus(); return; }
      var had = !!replies[id];
      replies[id] = { body: body.slice(0, MAX), artistId: s.artistId, artistName: s.nome, at: new Date().toISOString(), edited: had };
      saveReplies(); renderReview(card);
      $('.rp-status', card).textContent = had ? 'Resposta atualizada.' : 'Resposta publicada.';
      $('[data-act="open"]', card).focus();
    });

    /* ---------- navegação entre telas ---------- */
    var TITLES = { home: 'ArtConnect · Contrate artistas locais', login: 'Entrar · ArtConnect', cadastro: 'Criar conta · ArtConnect' };
    function route() {
      var h = location.hash.replace(/^#\/?/, ''), v = (h === 'login' || h === 'cadastro') ? h : 'home';
      if (v !== 'home' && getSession()) { v = 'home'; if (location.hash !== '#/') history.replaceState(null, '', '#/'); }
      $$('.view').forEach(function (el) { el.hidden = el.dataset.view !== v; });
      document.body.dataset.view = v; document.title = TITLES[v];
      window.scrollTo(0, 0);
      refreshHeader(); renderReviews();
    }
    function refreshHeader() { $('#logout').hidden = !getSession(); }
    window.addEventListener('hashchange', route);

    document.addEventListener('click', function (e) {
      var a = e.target.closest('[data-soon]');
      if (!a) return;
      e.preventDefault();
      if (a.hasAttribute('data-needs-login') && !getSession()) { location.hash = '#/login'; toast('Entre na sua conta para acessar o painel.'); return; }
      toast('A tela “' + a.dataset.soon + '” ainda não foi criada neste protótipo.');
    });
    $('#logout').addEventListener('click', function () { setSession(null); toast('Você saiu da conta.'); route(); });

    /* ---------- login ---------- */
    $('#login-form').addEventListener('submit', function (e) {
      e.preventDefault();
      var msg = $('#login-msg'), uEl = $('#username'), pEl = $('#password');
      var user = uEl.value.trim().toLowerCase(), pass = pEl.value;
      msg.textContent = '';
      if (!user) { msg.textContent = 'Informe seu usuário.'; uEl.focus(); return; }
      if (pass.length < 6) { msg.textContent = 'A senha tem pelo menos 6 caracteres.'; pEl.focus(); return; }
      loadUsers().then(function (users) {
        var u = users[user];
        return sha(user, pass).then(function (h) {
          if (!u || u.hash !== h) { msg.textContent = 'Usuário ou senha incorretos.'; pEl.value = ''; pEl.focus(); return; }
          setSession(u, $('#remember').checked);
          e.target.reset();
          location.hash = '#/'; route();
          toast('Bem-vindo, ' + u.nome.split(' ')[0] + '!');
        });
      });
    });

    /* ---------- cadastro ---------- */
    var cad = $('#cad-form');
    function tipo() { return cad.elements.tipo.value; }
    $$('input[name="tipo"]', cad).forEach(function (r) { r.addEventListener('change', function () { $('#artist-fields').hidden = tipo() !== 'artista'; }); });
    function setErr(id, field, text) {
      $('#e-' + id).textContent = text || '';
      var el = $(field); if (el) { if (text) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid'); }
      return !text;
    }
    cad.addEventListener('submit', function (e) {
      e.preventDefault();
      var f = cad.elements, nome = f.nome.value.trim(), usuario = f.usuario.value.trim().toLowerCase(), email = f.email.value.trim(),
          senha = f.senha.value, senha2 = f.senha2.value, art = tipo() === 'artista';
      var checks = [
        ['nome', '#c-nome', nome.length < 3 ? 'Informe seu nome completo.' : ''],
        ['usuario', '#c-usuario', !/^[a-z0-9_]{3,20}$/.test(usuario) ? 'Use de 3 a 20 letras minúsculas, números ou _.' : ''],
        ['email', '#c-email', !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email) ? 'Informe um e-mail válido.' : ''],
        ['categoria', '#c-categoria', art && !f.categoria.value ? 'Escolha sua categoria.' : ''],
        ['cidade', '#c-cidade', art && f.cidade.value.trim().length < 2 ? 'Informe a cidade onde atua.' : ''],
        ['senha', '#c-senha', senha.length < 6 ? 'A senha precisa ter pelo menos 6 caracteres.' : ''],
        ['senha2', '#c-senha2', senha2 !== senha ? 'As senhas não são iguais.' : ''],
        ['termos', '#c-termos', !$('#c-termos').checked ? 'Aceite os termos para continuar.' : '']
      ];
      var firstBad = null;
      checks.forEach(function (c) { if (!setErr(c[0], c[1], c[2]) && !firstBad) firstBad = c[1]; });
      $('#cad-msg').textContent = '';
      if (firstBad) { $(firstBad).focus(); return; }

      loadUsers().then(function (users) {
        if (users[usuario]) { setErr('usuario', '#c-usuario', 'Este usuário já existe. Escolha outro.'); $('#c-usuario').focus(); return; }
        return sha(usuario, senha).then(function (h) {
          var u = { usuario: usuario, nome: nome, email: email, tipo: art ? 'artista' : 'cliente', hash: h,
                    categoria: art ? f.categoria.value : undefined, cidade: art ? f.cidade.value.trim() : undefined, artistId: art ? slug(nome) || usuario : null };
          users[usuario] = u; lset(K_USERS, users);
          setSession(u, false); cad.reset(); $('#artist-fields').hidden = true;
          location.hash = '#/'; route();
          toast('Conta criada! Bem-vindo, ' + nome.split(' ')[0] + '.');
        });
      });
    });

    route();
  })();
  </script>
</body>
</html>
