-- =====================================================
-- SEGURANÇA (RLS) - regras básicas para o Supabase
-- =====================================================
ALTER TABLE profiles          ENABLE ROW LEVEL SECURITY;
ALTER TABLE categorias        ENABLE ROW LEVEL SECURITY;
ALTER TABLE artistas          ENABLE ROW LEVEL SECURITY;
ALTER TABLE eventos           ENABLE ROW LEVEL SECURITY;
ALTER TABLE pedidos_orcamento ENABLE ROW LEVEL SECURITY;
ALTER TABLE propostas         ENABLE ROW LEVEL SECURITY;
ALTER TABLE contratos         ENABLE ROW LEVEL SECURITY;
ALTER TABLE pagamentos        ENABLE ROW LEVEL SECURITY;
ALTER TABLE avaliacoes        ENABLE ROW LEVEL SECURITY;
ALTER TABLE mensagens         ENABLE ROW LEVEL SECURITY;
ALTER TABLE chamados_suporte  ENABLE ROW LEVEL SECURITY;
 
-- Leitura pública: categorias, artistas ativos e avaliações
CREATE POLICY "categorias_publicas" ON categorias FOR SELECT USING (true);
CREATE POLICY "artistas_publicos"   ON artistas   FOR SELECT USING (ativo);
CREATE POLICY "avaliacoes_publicas" ON avaliacoes FOR SELECT USING (true);
 
-- Perfil: cada um vê e edita o próprio
CREATE POLICY "perfil_proprio_select" ON profiles FOR SELECT USING (id = auth.uid());
CREATE POLICY "perfil_proprio_update" ON profiles FOR UPDATE USING (id = auth.uid());
 
-- Eventos: só o cliente dono
CREATE POLICY "eventos_do_cliente" ON eventos
    FOR ALL USING (cliente_id = auth.uid()) WITH CHECK (cliente_id = auth.uid());
 
-- Pedidos de orçamento: via dono do evento
CREATE POLICY "pedidos_do_cliente" ON pedidos_orcamento
    FOR ALL USING (EXISTS (SELECT 1 FROM eventos e
                           WHERE e.id = evento_id AND e.cliente_id = auth.uid()));
 
-- Contratos: cliente ou o artista do contrato
CREATE POLICY "contratos_participantes" ON contratos
    FOR SELECT USING (
        cliente_id = auth.uid()
        OR EXISTS (SELECT 1 FROM artistas a WHERE a.id = artista_id AND a.user_id = auth.uid())
    );
 
-- Pagamentos: visíveis para o cliente do contrato
CREATE POLICY "pagamentos_do_cliente" ON pagamentos
    FOR SELECT USING (EXISTS (SELECT 1 FROM contratos c
                              WHERE c.id = contrato_id AND c.cliente_id = auth.uid()));
 
-- Mensagens: quem enviou ou recebeu
CREATE POLICY "mensagens_participantes" ON mensagens
    FOR SELECT USING (remetente_id = auth.uid() OR destinatario_id = auth.uid());
CREATE POLICY "mensagens_enviar" ON mensagens
    FOR INSERT WITH CHECK (remetente_id = auth.uid());
 
-- Suporte: só o próprio usuário
CREATE POLICY "suporte_proprio" ON chamados_suporte
    FOR ALL USING (user_id = auth.uid()) WITH CHECK (user_id = auth.uid());
 
